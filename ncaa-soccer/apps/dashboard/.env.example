# Origin of the NCADB API, no trailing slash. Baked into the bundle at build time,
# so it must be set in Vercel's project settings for Production and Preview.
VITE_API_BASE_URL=https://your-api.up.railway.app

# Local development only: where the Vite dev server proxies /api to.
# VITE_DEV_API_PROXY=http://localhost:3001

# Path prefix the site is served under (satifyy.com/ncadb/). Empty for a root deploy.
BASE_PATH=/ncadb

# Clerk publishable key (pk_live_… in production, pk_test_… for development). Public by
# design: it only names the Clerk instance. Unset: no login button and no Clerk script,
# and the account pages say sign-in is unavailable. Never put a secret key (sk_…) here:
# everything prefixed VITE_ is shipped to the browser.
VITE_CLERK_PUBLISHABLE_KEY=
