# NCADB — server environment (API and ingestion worker). Copy to .env for local use;
# never commit real values. On Railway these are service variables.

# --- Database ---------------------------------------------------------------------
# On Railway: reference the Postgres service's private URL, ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ncadb
# Only for connections through Railway's public TCP proxy (not needed in-project).
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=120000

LOG_LEVEL=info
NODE_ENV=production

# --- API --------------------------------------------------------------------------
PORT=3001
# Comma-separated. `*` matches one DNS-label fragment, for Vercel preview URLs.
CORS_ALLOWED_ORIGINS=https://your-site.vercel.app,https://your-project-*-your-team.vercel.app
# Enables /api/v1/admin (read-only ops detail). 24+ random characters, e.g. `openssl rand -hex 24`.
ADMIN_API_TOKEN=
RATE_LIMIT_PER_MINUTE=300
API_CACHE_SECONDS=300

# --- Ingestion worker -------------------------------------------------------------
INGESTION_MODE=incremental
# Days back a stored box score is still re-fetched for corrections.
INGESTION_LOOKBACK_DAYS=7
# Months the season is played; outside them the nightly run records itself and exits.
INGESTION_ACTIVE_MONTHS=8-12
# A stage may lose at most this share of a season's rows before it counts as failed.
INGESTION_MAX_DROP_PCT=3
NIGHTLY_TIMEZONE=America/Chicago
NIGHTLY_LOCAL_HOUR=3
NIGHTLY_RECOVERY_AFTER_HOURS=26
STALE_AFTER_HOURS=36
ANALYTICS_ENABLED=true
WORK_DIR=/tmp/ncadb-work
# Slack/Discord/generic webhook for failure alerts. Unset: alerts go to the logs only.
ALERT_WEBHOOK_URL=

# --- Scraper politeness -----------------------------------------------------------
SCRAPER_CONCURRENCY=3
# Delay between requests to JSON APIs (WMT). Page hosts use SCRAPER_HOST_DELAY_MS.
SCRAPER_REQUEST_DELAY_MS=1500
# Minimum gap between requests to one school's site; Sidearm robots.txt asks for 30s.
SCRAPER_HOST_DELAY_MS=30000
SCRAPER_MAX_RETRIES=3
# SCRAPER_USER_AGENT=   (default: a browser string plus "NcaDB/1.0 (+https://github.com/satifyy/NcaDB)")
