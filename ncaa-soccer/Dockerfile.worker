# Ingestion worker: the existing scrapers (Playwright for Sidearm sites) plus the
# database loader. Runs as a Railway cron service: starts, does one run, exits.
#
# The base image carries Chromium for exactly the Playwright version in the lockfile
# (playwright-chromium 1.57.0); bump the two together.
FROM mcr.microsoft.com/playwright:v1.57.0-noble

ENV NODE_ENV=production \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    WORK_DIR=/tmp/ncadb-work \
    npm_config_update_notifier=false

WORKDIR /app
COPY . .
# Dev dependencies included: tsx runs the TypeScript scripts, as it does locally.
# The code stays owned by root: the runtime user can read and execute it but not
# change it. Everything the worker writes goes to WORK_DIR under /tmp.
RUN npm ci --include=dev --no-audit --no-fund \
    && npx tsc -b \
    && chmod -R a-w /app

USER pwuser
CMD ["npx", "tsx", "apps/worker/src/cli.ts", "nightly", "--cron"]
