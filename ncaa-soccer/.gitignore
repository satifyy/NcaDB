node_modules
data/raw/
scratch/

# Regenerated by every scraper run; committing them makes the scheduled refresh churn
# the repository with logs nobody reads from git.
data/player_stats/*.log
data/player_stats/fileshtml.html

# Which pipeline stages a given machine has completed. Local progress, not shared state:
# a CI runner's copy says nothing useful about a laptop's half-finished backfill.
data/pipeline_state.json

# Derived from the CSVs in data/ by the two generate steps in the dashboard's build, so
# the site rebuilds it at deploy time. Committing it meant every refresh run pushed 70 MB
# of JSON that says nothing the CSVs beside it don't already say.
apps/dashboard/src/data/
